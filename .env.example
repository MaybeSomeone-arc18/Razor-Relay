# Razor-Relay Environment Configuration
# Copy this file to .env and fill in your values

# --- Razorpay Test-Mode Credentials ---
# Get these from https://dashboard.razorpay.com/app/keys (Test Mode)
RZP_TEST_KEY=rzp_test_XXXXXXXXXXXXXX
RZP_TEST_SECRET=XXXXXXXXXXXXXXXXXXXXXXX

# --- AI Classifier Configuration ---
# LLM_PROVIDER can be 'ollama' or 'gemini'.
# The default codebase expects 'ollama' to run locally without rate limits.
# If the AI is unavailable, the system falls back to keyword heuristic.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b

# Only required if LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434

# Only required if LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Only required if LLM_PROVIDER=groq
GROQ_API_KEY=

# --- Mandate Gateway Secret ---
# Used for HMAC-SHA256 signature generation
MANDATE_SECRET_KEY=default_secret

# --- Upstash Redis (optional, in-memory fallback if not set) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
